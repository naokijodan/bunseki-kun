{
  "manifest_version": 3,
  "name": "ぶんせき君",
  "short_name": "ぶんせき君",
  "version": "4.6.1",
  "description": "eBayからダウンロードしたCSVの分析、市場データのCSV・ZIP読み込み、AIによる販売戦略の提案を行う統合ツール（OpenAI, Claude, Gemini対応）",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
